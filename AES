import javax.crypto.*;
import java.util.*;
import java.util.Base64;

public class AESDemo {
    public static void main(String[] args) throws Exception {
        KeyGenerator keygen = KeyGenerator.getInstance("AES");
        keygen.init(128);
        SecretKey key = keygen.generateKey();

        Scanner sc = new Scanner(System.in);
        System.out.print("Plain Text: ");
        String plain = sc.next();

        Cipher c = Cipher.getInstance("AES/ECB/PKCS5Padding");
        c.init(Cipher.ENCRYPT_MODE, key);
        String encrypted = Base64.getEncoder().encodeToString(c.doFinal(plain.getBytes()));

        c.init(Cipher.DECRYPT_MODE, key);
        String decrypted = new String(c.doFinal(Base64.getDecoder().decode(encrypted)));

        System.out.println("Encryption: " + encrypted);
        System.out.println("Decryption: " + decrypted);
    }
}

